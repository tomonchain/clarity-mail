{
  "name": "clarity-mail",
  "version": "1.0.0-beta.1",
  "private": true,
  "scripts": {
    "dev": "next dev -p 4317",
    "dev:all": "concurrently -k -n web,sync \"next dev -p 4317 -H 0.0.0.0\" \"tsx src/worker/index.ts\"",
    "dev:local": "node scripts/dev-local.mjs",
    "dev:setup": "node scripts/dev-setup.mjs",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p ${PORT:-4317}",
    "worker": "tsx src/worker/index.ts",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:mail": "tsx scripts/test-mail.ts",
    "test:detect": "tsx scripts/test-detect.ts",
    "test:vault": "tsx scripts/test-vault.ts",
    "test:push": "tsx scripts/test-push.ts",
    "test:sync": "tsx scripts/test-sync.ts",
    "bootstrap": "tsx scripts/dev-bootstrap.ts",
    "desktop:build": "node desktop/build.mjs",
    "desktop:install": "node desktop/build.mjs --install",
    "release": "tsx scripts/release.ts",
    "mobile:ios": "npm --prefix mobile run ios",
    "mobile:android": "npm --prefix mobile run android"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@vercel/blob": "^2.8.1",
    "better-sqlite3-multiple-ciphers": "13.0.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "imapflow": "^2.4.0",
    "lucide-react": "^1.55.0",
    "mailparser": "^3.9.38",
    "next": "16.4.2",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sanitize-html": "^2.18.0",
    "shadcn": "^4.21.4",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.2",
    "concurrently": "^10.0.6",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
