# 32-byte key as 64 hex characters. Generated automatically into the data directory if empty.
SORTED_SECRET=

# Where sorted.db and the key file live. Docker Compose sets this to /data.
SORTED_DATA_DIR=./data

# Set to 1 when the app is served over HTTPS.
SORTED_SECURE_COOKIE=0

# Optional. DeepSeek is used when its key is set. Otherwise Mistral.
# Without either, triage uses header and phrase rules only.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# Dev only. Shows the password on the sign-in page. Never set this on a server.
SORTED_DEV_LOGIN_HINT=
SORTED_DEV_PASSWORD=sorted-dev
